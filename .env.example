# Copie para .env e preencha. NUNCA versione o .env.
APP_ENV=dev
API_KEY=troque-por-um-valor-aleatorio-longo
GROQ_API_KEY=
TAVILY_API_KEY=
HUBSPOT_TOKEN=
# Postgres do docker-compose; o DATABASE_URL deve usar o mesmo usuário/senha/banco.
POSTGRES_USER=lead
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lead_qualifier
# Porta no host (mude se a 5432 já estiver em uso; ajuste o DATABASE_URL junto).
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lead:troque-esta-senha@localhost:5432/lead_qualifier
OLLAMA_BASE_URL=http://localhost:11434
LANGSMITH_API_KEY=
