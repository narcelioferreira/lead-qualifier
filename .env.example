# Copie para .env e preencha. NUNCA versione o .env.
APP_ENV=dev
API_KEY=troque-por-um-valor-aleatorio-longo
GROQ_API_KEY=
TAVILY_API_KEY=
# Chave de serviço do HubSpot (Configurações → Integrações → Chaves de serviço). Escopos:
# crm.schemas.companies.read/write e crm.schemas.contacts.read/write (setup, T17).
HUBSPOT_TOKEN=
# Token do servidor MCP lead-tools (T19), mínimo de 32 caracteres. Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOLS_MCP_TOKEN=
TOOLS_MCP_PORT=8001
# Endpoint usado pelo grafo (T20). Fora da máquina ou do compose, só https.
TOOLS_MCP_URL=http://127.0.0.1:8001/mcp

# API (T21). Gravar no HubSpot é opt-in. Fila: 1 execução por vez (plano gratuito da Groq).
API_WRITE_CRM=false
API_PROMPT_VERSION=v2
API_MAX_CONCURRENT_RUNS=1
API_MAX_PENDING_RUNS=10
# Postgres do docker-compose; o DATABASE_URL deve usar o mesmo usuário/senha/banco.
POSTGRES_USER=lead
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lead_qualifier
# Porta no host (mude se a 5432 já estiver em uso; ajuste o DATABASE_URL junto).
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lead:troque-esta-senha@localhost:5432/lead_qualifier
OLLAMA_BASE_URL=http://localhost:11434
LANGSMITH_API_KEY=
