# Servidor MCP `lead-tools` (T19). Imagens fixadas por digest (ASI04 / AST02).
# Build: docker compose build tools-mcp

FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
# Só as dependências de produção, exatamente as do lockfile (com hash).
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --no-install-project
COPY app ./app
COPY tools_mcp ./tools_mcp
RUN uv sync --locked --no-dev

FROM python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
# Sem binários setuid/setgid: substitui o `no-new-privileges`, que o Docker do snap não
# suporta (o exec falha com "operation not permitted"). Com `cap_drop: ALL` e usuário sem
# privilégio, não sobra caminho de escalada.
RUN useradd --system --uid 10001 --no-create-home tools \
    && find / -xdev -perm /6000 -type f -exec chmod a-s {} +
WORKDIR /app
COPY --from=build --chown=root:root /app /app
# Fixtures dos domínios `.example` (avaliação), só leitura.
COPY --chown=root:root evals/fixtures/companies /app/fixtures
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TOOLS_MCP_HOST=0.0.0.0 \
    TOOLS_MCP_PORT=8001 \
    FIXTURES_DIR=/app/fixtures
USER tools
EXPOSE 8001
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
    CMD ["python", "-c", "import socket; socket.create_connection(('127.0.0.1', 8001), 2)"]
CMD ["python", "-m", "tools_mcp.server"]
