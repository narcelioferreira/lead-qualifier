---
graph TD;
	__start__([<p>__start__</p>]):::first
	validate_input(validate_input)
	agentic_research(agentic_research)
	normalize(normalize)
	assess(assess)
	compute_score(compute_score)
	write_to_crm(write_to_crm)
	audit_log(audit_log)
	suggest_next_step(suggest_next_step)
	guardrail(guardrail)
	request_review(request_review)
	human_review(human_review)
	__end__([<p>__end__</p>]):::last
	__start__ --> validate_input;
	agentic_research -. &nbsp;done&nbsp; .-> normalize;
	assess --> compute_score;
	compute_score -. &nbsp;review&nbsp; .-> request_review;
	compute_score -. &nbsp;continue&nbsp; .-> suggest_next_step;
	guardrail -. &nbsp;continue&nbsp; .-> agentic_research;
	guardrail -. &nbsp;block&nbsp; .-> compute_score;
	human_review --> suggest_next_step;
	normalize -. &nbsp;continue&nbsp; .-> assess;
	normalize -. &nbsp;fail&nbsp; .-> audit_log;
	request_review -. &nbsp;wait&nbsp; .-> human_review;
	request_review -. &nbsp;skip&nbsp; .-> suggest_next_step;
	suggest_next_step --> write_to_crm;
	validate_input -. &nbsp;reject&nbsp; .-> audit_log;
	validate_input -. &nbsp;continue&nbsp; .-> guardrail;
	write_to_crm --> audit_log;
	audit_log --> __end__;
	agentic_research -. &nbsp;continue&nbsp; .-> agentic_research;
